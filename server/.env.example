PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# Generate with: node scripts/hash-password.js "원하는비밀번호"
SITE_PASSWORD_HASH=
# Set to true only when served over HTTPS (behind nginx with SSL)
COOKIE_SECURE=false
# Google Cloud API key restricted to your domain's HTTP referrer. Without this, map
# links just open Google Maps in a new tab instead of showing an embedded/interactive
# map. Needs "Maps Embed API" (single-place map links), "Maps JavaScript API" and
# "Geocoding API" (the interactive route maps with numbered pins) enabled and allowed
# in the key's "API restrictions" list in Cloud Console.
GOOGLE_MAPS_API_KEY=
