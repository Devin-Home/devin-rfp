PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# Generate with: node scripts/hash-password.js "원하는비밀번호"
SITE_PASSWORD_HASH=
# Set to true only when served over HTTPS (behind nginx with SSL)
COOKIE_SECURE=false
# Google Cloud API key with "Maps Embed API" enabled, restricted to your domain's
# HTTP referrer. Without this, map links just open Google Maps in a new tab as before.
# For the route distance/time summary, also enable "Directions API" on the same key
# (the "API restrictions" list in Cloud Console) — no separate key needed.
GOOGLE_MAPS_API_KEY=
